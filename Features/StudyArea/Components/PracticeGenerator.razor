@using ProfAlan.Domain.Regular
@using ProfAlan.Features.StudyArea.Models
@using ProfAlan.Features.StudyArea.Services
@implements IDisposable
@inject GeminiClient Gemini
@inject PendingQuizDraft Pending
@inject AuthSession Auth
@inject NavigationManager Navigation

<div class="grid gap-5 lg:grid-cols-[22rem_minmax(0,1fr)]">
    <aside class="space-y-5">
        <section class="card">
            <div class="card-header">
                <p class="eyebrow">AI assistant</p>
                @if (Ready)
                {
                    <span class="badge-pass"><Icon Name="check" Class="size-3" /> Ready</span>
                }
                else
                {
                    <span class="badge-warn">Unavailable</span>
                }
            </div>
            <div class="space-y-3 p-4 text-sm">
                <p class="leading-relaxed">Powered by Google Gemini on the free tier and hosted by ProfAlan, so you can use it right away without an API key.</p>
                <p class="flex gap-2 text-xs text-muted">
                    <Icon Name="shield" Class="mt-0.5 size-3.5" />
                    <span>Requests go through ProfAlan's server, which keeps the project key secret. Your prompt is sent to Google to generate the answer.</span>
                </p>
                @if (!Ready)
                {
                    <p class="text-xs text-warn">The assistant needs the Supabase connection, which is not configured in this copy of the app.</p>
                }
            </div>
        </section>

        <section class="card">
            <div class="card-header">
                <div class="flex gap-1 rounded-lg bg-soft p-0.5 text-sm">
                    <button type="button" class="@($"tab px-2.5 py-1 {(mode == "problem" ? "tab-active" : "")}")" @onclick='() => mode = "problem"'>Practice problem</button>
                    <button type="button" class="@($"tab px-2.5 py-1 {(mode == "explain" ? "tab-active" : "")}")" @onclick='() => mode = "explain"'>Explain a language</button>
                </div>
            </div>
            <div class="space-y-3 p-4">
                @if (mode == "problem")
                {
                    <div>
                        <label class="label" for="gen-kind">Solver submits a</label>
                        <select id="gen-kind" class="field" @bind="answerKind">
                            @foreach (var kind in Enum.GetValues<AnswerKind>())
                            {
                                <option value="@kind">@kind.Label()</option>
                            }
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="label" for="gen-diff">Difficulty</label>
                            <select id="gen-diff" class="field" @bind="difficulty">
                                <option>introductory</option>
                                <option>midterm level</option>
                                <option>challenging</option>
                            </select>
                        </div>
                        <div>
                            <label class="label" for="gen-sigma">Alphabet Σ</label>
                            <input id="gen-sigma" class="field field-mono" @bind="alphabet" />
                        </div>
                    </div>
                    <div>
                        <label class="label" for="gen-topic">Topic focus (optional)</label>
                        <input id="gen-topic" class="field" @bind="topic" placeholder="substrings, counting modulo k, ..." />
                    </div>
                    <button type="button" class="btn btn-primary w-full" disabled="@(!Ready || busy)" @onclick="GenerateAsync">
                        @if (busy) { <Spinner /> } else { <Icon Name="wand" /> }
                        Generate problem
                    </button>
                }
                else
                {
                    <div>
                        <label class="label" for="explain-text">Regular expression, grammar or set notation</label>
                        <textarea id="explain-text" rows="3" class="field field-mono" @bind="languageText" placeholder="(a ∪ b)*bba(a ∪ b)*"></textarea>
                    </div>
                    <button type="button" class="btn btn-primary w-full" disabled="@(!Ready || busy || string.IsNullOrWhiteSpace(languageText))" @onclick="ExplainAsync">
                        @if (busy) { <Spinner /> } else { <Icon Name="book" /> }
                        Explain
                    </button>
                }
                @if (!Ready)
                {
                    <p class="text-xs text-muted">The AI assistant is unavailable in this copy of the app.</p>
                }
            </div>
        </section>
    </aside>

    <div class="min-w-0">
        @if (error is not null)
        {
            <p class="mb-5 flex items-start gap-2 rounded-lg border border-fail/30 bg-fail/10 px-4 py-3 text-sm text-fail"><Icon Name="alert" Class="mt-0.5 size-4" /> @error</p>
        }

        @if (mode == "problem" && problem is not null)
        {
            <article class="card">
                <div class="card-header">
                    <div class="flex flex-wrap gap-2">
                        <span class="chip">@problem.Quiz.AnswerKind.Label()</span>
                        <span class="chip">Σ = {@string.Join(", ", problem.Quiz.Alphabet.ToCharArray())}</span>
                    </div>
                    <span class="@(problem.IsVerified ? "badge-pass" : "badge-warn")">@(problem.IsVerified ? "Verified by ProfAlan" : "Needs review")</span>
                </div>
                <div class="space-y-5 p-5">
                    <div>
                        <h2 class="font-display text-2xl">@problem.Quiz.Title</h2>
                        <p class="mt-2 leading-relaxed">@problem.Quiz.Prompt</p>
                    </div>

                    @foreach (var note in problem.Notes)
                    {
                        <p class="flex items-start gap-2 text-xs text-muted"><Icon Name="info" Class="mt-0.5 size-3.5" /> @note</p>
                    }

                    <details class="rounded-lg border border-line px-4 py-3">
                        <summary class="cursor-pointer text-sm font-medium">Hint</summary>
                        <p class="mt-2 text-sm text-muted">@problem.Hint</p>
                    </details>
                    <details class="rounded-lg border border-line px-4 py-3">
                        <summary class="cursor-pointer text-sm font-medium">Reference answer (spoiler)</summary>
                        <p class="mt-2 whitespace-pre-line font-mono text-sm">@problem.ReferenceAnswer</p>
                    </details>

                    <div class="overflow-hidden rounded-lg border border-line">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-soft text-xs text-muted">
                                <tr><th class="px-4 py-2 font-medium">Input</th><th class="px-4 py-2 font-medium">Expected</th><th class="px-4 py-2 font-medium">Visibility</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var c in problem.Cases)
                                {
                                    var disputed = problem.Disagreements.Contains(c.Input);
                                    <tr class="@($"border-t border-line {(disputed ? "bg-warn/10" : "")}")" title="@(disputed ? "The reference answer gives the opposite verdict" : "")">
                                        <td class="px-4 py-1.5 font-mono">
                                            @Symbols.Show(c.Input)
                                            @if (disputed)
                                            {
                                                <Icon Name="alert" Class="ml-1 inline size-3.5 text-warn" />
                                            }
                                        </td>
                                        <td class="px-4 py-1.5 font-medium @(c.ShouldAccept ? "text-pass" : "text-fail")">@(c.ShouldAccept ? "Accept" : "Reject")</td>
                                        <td class="px-4 py-1.5 text-muted">@(c.IsHidden ? "Hidden" : "Visible")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="flex flex-wrap gap-2">
                        <a href="@SandboxHref" class="btn"><Icon Name="flask" /> Practice in the sandbox</a>
                        <button type="button" class="btn btn-primary" @onclick="SaveAsQuiz"><Icon Name="save" /> Turn into a quiz</button>
                    </div>
                </div>
            </article>
        }
        else if (mode == "explain" && explanation is not null)
        {
            <article class="card space-y-5 p-5">
                <div>
                    <p class="eyebrow">Language</p>
                    <p class="mt-1 font-mono">@explainedText</p>
                </div>
                <p class="font-display text-xl leading-snug">@explanation.Summary</p>
                <p class="whitespace-pre-line leading-relaxed">@explanation.Explanation</p>
                <div class="grid gap-4 sm:grid-cols-2">
                    @ExampleList("In the language", explanation.Members, expected: true)
                    @ExampleList("Not in the language", explanation.NonMembers, expected: false)
                </div>
                @if (explainOracle is not null)
                {
                    <p class="flex items-start gap-2 text-xs text-muted"><Icon Name="info" Class="mt-0.5 size-3.5" /> Each example was re-checked by ProfAlan's own engine; a red mark means the AI got that example wrong.</p>
                }
            </article>
        }
        else if (!busy)
        {
            <EmptyState IconName="wand" Title="Generate a practice problem"
                        Message="Gemini drafts the language, a reference answer and a test suite. ProfAlan re-checks every expected verdict against the reference before you use it." />
        }
        else
        {
            <div class="grid min-h-[30vh] place-items-center text-center text-muted">
                <div>
                    <Spinner Class="mx-auto size-6" />
                    @if (mode == "problem")
                    {
                        <p class="mt-3 text-sm">Drafting and checking the problem (attempt @attemptsUsed of @MaxAttempts)…</p>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string mode = "problem";
    private AnswerKind answerKind = AnswerKind.Dfa;
    private string difficulty = "midterm level";
    private string alphabet = "ab";
    private string topic = "";
    private string languageText = "";
    private string explainedText = "";
    private bool busy;
    private string? error;
    private VerifiedProblem? problem;
    private LanguageExplanation? explanation;
    private Func<string, bool>? explainOracle;
    private readonly CancellationTokenSource cancel = new();

    private const int MaxAttempts = 3;
    private int attemptsUsed;

    private bool Ready => Gemini.HasProjectAssistant;


    private string SandboxHref => problem?.Quiz.AnswerKind switch
    {
        AnswerKind.Regex => "sandbox?kind=regex",
        AnswerKind.Grammar => "sandbox?kind=cfg",
        { } kind => $"sandbox?kind={kind.Machine()!.Value.Slug()}",
        _ => "sandbox"
    };

    private async Task GenerateAsync()
    {
        if (!Ready) return;
        busy = true;
        error = null;
        try
        {
            var request = new GenerationRequest(string.IsNullOrWhiteSpace(topic) ? "any classic topic" : topic, answerKind.Label(), difficulty, alphabet);

            // A model can contradict itself; ask again until the reference answer and the labels agree.
            for (var attempt = 1; attempt <= MaxAttempts; attempt++)
            {
                attemptsUsed = attempt;
                StateHasChanged();
                var generated = await Gemini.GenerateProblemAsync(request, cancel.Token);
                problem = ProblemVerifier.Verify(generated with { AnswerKind = answerKind.ToString() });
                if (problem.IsVerified) break;
            }
        }
        catch (GeminiException ex)
        {
            error = ex.Message;
        }
        catch (TaskCanceledException)
        {
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ExplainAsync()
    {
        if (!Ready) return;
        busy = true;
        error = null;
        try
        {
            explanation = await Gemini.ExplainLanguageAsync(languageText, cancel.Token);
            explainedText = languageText;
            explainOracle = QuizGrader.ReferenceOracle(languageText, out _);
        }
        catch (GeminiException ex)
        {
            error = ex.Message;
        }
        catch (TaskCanceledException)
        {
        }
        finally
        {
            busy = false;
        }
    }

    private RenderFragment ExampleList(string heading, IReadOnlyList<string> words, bool expected) => __builder =>
    {
        <div>
            <p class="label">@heading</p>
            <ul class="flex flex-wrap gap-1.5">
                @foreach (var w in words)
                {
                    var word = Symbols.IsEmpty(w) ? "" : w.Trim();
                    var wrong = explainOracle is not null && explainOracle(word) != expected;
                    <li class="@($"chip {(wrong ? "border-fail text-fail line-through" : "")}")" title="@(wrong ? "ProfAlan disagrees with this example" : "")">@Symbols.Show(word)</li>
                }
            </ul>
        </div>
    };

    private void SaveAsQuiz()
    {
        if (problem is null) return;
        Pending.Offer(problem.Quiz, problem.Cases);
        Navigation.NavigateTo(Auth.Current is null ? "login?returnUrl=quizzes%2Fcreate" : "quizzes/create");
    }

    public void Dispose()
    {
        cancel.Cancel();
        cancel.Dispose();
    }
}
