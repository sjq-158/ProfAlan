@using ProfAlan.Features.StudyArea.Models

<article class="card p-6 sm:p-8">
    <p class="eyebrow">Lewis &amp; Papadimitriou @Topic.Section</p>
    <h2 class="mt-2 font-display text-3xl">@Topic.Title</h2>
    <p class="mt-2 text-lg text-muted">@Topic.Summary</p>

    <div class="mt-6 space-y-5">
        @foreach (var block in Topic.Blocks)
        {
            @switch (block.Kind)
            {
                case NoteKind.Definition:
                    <section class="rounded-lg border border-line bg-surface/60 p-5">
                        <p class="eyebrow mb-2">Definition · @block.Title</p>
                        <p class="leading-relaxed">@block.Text</p>
                        @if (block.Formal is not null)
                        {
                            <p class="mt-3 overflow-x-auto rounded-md bg-card px-3 py-2 font-mono text-[13px]">@block.Formal</p>
                        }
                    </section>
                    break;
                case NoteKind.Example:
                    <section class="rounded-lg border border-line p-5">
                        <p class="eyebrow mb-2">Worked example · @block.Title</p>
                        <p class="leading-relaxed">@block.Text</p>
                        @if (block.Formal is not null)
                        {
                            <p class="mt-3 overflow-x-auto rounded-md bg-soft px-3 py-2 font-mono text-[13px]">@block.Formal</p>
                        }
                    </section>
                    break;
                case NoteKind.Tip:
                    <p class="flex gap-3 rounded-lg bg-soft px-4 py-3 text-sm leading-relaxed">
                        <Icon Name="info" Class="mt-0.5 size-4" /> <span>@block.Text</span>
                    </p>
                    break;
                default:
                    <p class="leading-relaxed">@block.Text</p>
                    break;
            }
        }
    </div>

    @if (Topic.Links.Count > 0)
    {
        <div class="mt-6 flex flex-wrap gap-2 border-t border-line pt-5">
            @foreach (var link in Topic.Links)
            {
                <a href="@link.Href" class="btn"><Icon Name="external" /> @link.Label</a>
            }
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public TheoryTopic Topic { get; set; } = default!;
}
