<section class="card">
    <div class="card-header">
        <div>
            <p class="eyebrow">@(IsSubmission ? "Submission result" : "Sample test run")</p>
            <p class="mt-0.5 text-xs text-muted">@(IsSubmission ? "Graded against every visible and hidden case." : "Visible cases only. Nothing is recorded.")</p>
        </div>
        @if (Report.IsPerfect)
        {
            <span class="badge-pass"><Icon Name="check" Class="size-3" /> @Report.Passed / @Report.Total passed</span>
        }
        else
        {
            <span class="badge-fail">@Report.Passed / @Report.Total passed</span>
        }
    </div>

    <div class="space-y-3 p-5">
        <div class="h-2 overflow-hidden rounded-full bg-soft" role="progressbar" aria-valuenow="@Report.Percent" aria-valuemin="0" aria-valuemax="100">
            <div class="@($"h-full rounded-full transition-all {(Report.IsPerfect ? "bg-pass" : "bg-fail")}")" style="width:@(Report.Percent)%"></div>
        </div>

        @if (Report.AnswerError is not null)
        {
            <p class="flex items-start gap-2 rounded-lg border border-fail/30 bg-fail/10 px-3 py-2 text-sm text-fail">
                <Icon Name="alert" Class="mt-0.5 size-4" /> @Report.AnswerError
            </p>
        }
        @foreach (var note in Report.Notes)
        {
            <p class="flex items-start gap-2 text-xs text-warn"><Icon Name="info" Class="mt-0.5 size-3.5" /> @note</p>
        }

        <ul class="divide-y divide-line overflow-hidden rounded-lg border border-line">
            @foreach (var r in Report.Results)
            {
                <li class="flex items-center gap-3 px-3 py-2 text-sm">
                    <span class="@($"grid size-6 shrink-0 place-items-center rounded-full text-white {(r.Passed ? "bg-pass" : "bg-fail")}")">
                        <Icon Name="@(r.Passed ? "check" : "x")" Class="size-3.5" StrokeWidth="2.5" />
                    </span>
                    @if (r.IsHidden)
                    {
                        <span class="flex items-center gap-1.5 text-muted"><Icon Name="lock" Class="size-3.5" /> Hidden test @r.Number</span>
                        <span class="ml-auto text-xs text-muted">@(r.Passed ? "Passed" : "Failed")</span>
                    }
                    else
                    {
                        <span class="font-mono">@Symbols.Show(r.Input)</span>
                        <span class="ml-auto text-xs text-muted" title="@r.Detail">expected <span class="font-medium text-ink">@(r.ExpectedAccept ? "accept" : "reject")</span>, got <span class="@($"font-medium {(r.Passed ? "text-pass" : "text-fail")}")">@Describe(r.Actual)</span></span>
                    }
                </li>
            }
        </ul>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public GradeReport Report { get; set; } = default!;
    [Parameter] public bool IsSubmission { get; set; }

    private static string Describe(Verdict verdict) => verdict switch
    {
        Verdict.Accepted => "accept",
        Verdict.Rejected => "reject",
        Verdict.DidNotHalt => "no halt",
        _ => "invalid"
    };
}
