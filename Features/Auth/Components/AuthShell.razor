@inject AuthSession Auth

<div class="grid min-h-screen lg:grid-cols-[1.05fr_1fr]">
    <aside class="relative hidden overflow-hidden border-r border-line bg-soft lg:block">
        <div class="grid-paper absolute inset-0 opacity-60"></div>
        <div class="relative flex h-full flex-col justify-between p-10">
            <a href="" class="flex items-center gap-2.5">
                <BrandMark Class="size-9 text-ink" />
                <span class="font-display text-2xl">ProfAlan</span>
            </a>

            <svg viewBox="0 0 460 200" class="w-full max-w-lg text-ink" aria-hidden="true">
                <defs>
                    <marker id="auth-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                        <path d="M0 0 10 5 0 10z" fill="currentColor" />
                    </marker>
                </defs>
                <line x1="14" y1="110" x2="62" y2="110" stroke="currentColor" stroke-width="1.6" marker-end="url(#auth-arrow)" />
                <circle cx="90" cy="110" r="26" fill="var(--pa-card)" stroke="currentColor" stroke-width="1.8" />
                <text x="90" y="115" text-anchor="middle" class="fill-current font-mono text-[14px]">q0</text>
                <path d="M116 110 H196" stroke="currentColor" stroke-width="1.6" marker-end="url(#auth-arrow)" />
                <text x="156" y="100" text-anchor="middle" class="fill-current font-mono text-[13px]">a</text>
                <circle cx="224" cy="110" r="26" fill="var(--pa-card)" stroke="currentColor" stroke-width="1.8" />
                <text x="224" y="115" text-anchor="middle" class="fill-current font-mono text-[14px]">q1</text>
                <path d="M212 86 C 200 40, 248 40, 236 86" fill="none" stroke="currentColor" stroke-width="1.6" marker-end="url(#auth-arrow)" />
                <text x="224" y="44" text-anchor="middle" class="fill-current font-mono text-[13px]">a, b</text>
                <path d="M250 110 H330" stroke="currentColor" stroke-width="1.6" marker-end="url(#auth-arrow)" />
                <text x="290" y="100" text-anchor="middle" class="fill-current font-mono text-[13px]">b</text>
                <circle cx="358" cy="110" r="26" fill="var(--pa-card)" stroke="currentColor" stroke-width="1.8" />
                <circle cx="358" cy="110" r="20" fill="none" stroke="currentColor" stroke-width="1.4" />
                <text x="358" y="115" text-anchor="middle" class="fill-current font-mono text-[14px]">q2</text>
                <text x="230" y="186" text-anchor="middle" class="fill-current font-mono text-[12px] opacity-70">NFA for a(a ∪ b)*b</text>
            </svg>

            <blockquote class="max-w-md">
                <p class="font-display text-2xl leading-snug">"A string is accepted iff (s, w) ⊢* (q, e) for some q ∈ F."</p>
                <p class="mt-3 text-sm text-muted">Build it, step through it, and get graded on it.</p>
            </blockquote>
        </div>
    </aside>

    <section class="flex flex-col px-6 py-8 sm:px-12">
        <div class="flex items-center justify-between">
            <a href="" class="inline-flex items-center gap-1.5 text-sm text-muted transition hover:text-ink">
                <Icon Name="arrow-left" /> Back to home
            </a>
            <ThemePicker />
        </div>

        <div class="mx-auto flex w-full max-w-sm flex-1 flex-col justify-center py-10">
            <h1 class="font-display text-3xl">@Title</h1>
            <p class="mt-2 text-sm text-muted">@Subtitle</p>

            @if (Auth.IsDemo)
            {
                <div class="mt-5 flex gap-2.5 rounded-lg border border-line bg-soft px-3 py-2.5 text-xs text-muted">
                    <Icon Name="info" Class="mt-0.5 size-4 text-ink" />
                    <span>Demo mode: no Supabase project is configured, so your account and work are stored in this browser only.</span>
                </div>
            }

            <div class="mt-6">@ChildContent</div>
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
