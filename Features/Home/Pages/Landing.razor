@page "/"
@layout BareLayout

<PageTitle>ProfAlan Studio</PageTitle>

<div class="dot-grid flex min-h-screen flex-col">
    <header class="flex items-center justify-end gap-2 px-4 pt-5 sm:px-8">
        <AuthorizeView>
            <Authorized>
                <a href="dashboard" class="btn-pill px-4 py-2">Dashboard</a>
            </Authorized>
            <NotAuthorized>
                <a href="login" class="btn-pill px-4 py-2">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
        <ThemePicker />
    </header>

    <main class="flex-1">
        <section class="mx-auto flex max-w-4xl flex-col items-center px-4 pt-12 text-center sm:px-6 sm:pt-16">
            <span class="fade-up grid size-20 place-items-center rounded-2xl bg-ink text-surface shadow-lg">
                <BrandMark Class="size-11" />
            </span>
            <h1 class="fade-up mt-10 font-display text-6xl leading-none sm:text-8xl" style="animation-delay:.08s">
                ProfAlan <span class="text-muted/70">Studio</span>
            </h1>
            <p class="fade-up mt-12 max-w-3xl text-lg leading-loose text-muted sm:text-xl" style="animation-delay:.16s">
                Explore the theory of computation through interactive visualization. Build and simulate
                Finite Automata, Pushdown Automata, Turing Machines, Context-Free Grammars and Regular Expressions in real time.
            </p>
            <a href="sandbox" class="fade-up btn-pill btn-pill-primary mt-12 px-10 py-5 text-lg" style="animation-delay:.24s">
                Launch Application <Icon Name="arrow-right" Class="size-5" />
            </a>
        </section>

        <section class="mx-auto mt-28 grid max-w-6xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:grid-cols-3" aria-label="What you can do">
            @foreach (var card in Cards)
            {
                <a href="@card.Href" class="group rounded-3xl border border-line bg-card p-8 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                    <span class="grid size-12 place-items-center rounded-xl border border-line bg-surface/60 transition group-hover:bg-ink group-hover:text-surface">
                        <Icon Name="@card.Icon" Class="size-5" />
                    </span>
                    <h2 class="mt-8 text-xl font-semibold leading-snug">@card.Title</h2>
                    <p class="mt-3 leading-relaxed text-muted">@card.Text</p>
                </a>
            }
        </section>
    </main>

    <footer class="px-4 py-16 text-center text-sm text-muted">
        Developed for CSIT321 · Applications Development and Emerging Technologies
    </footer>
</div>

@code {
    private sealed record Card(string Icon, string Title, string Text, string Href);

    private static readonly Card[] Cards =
    [
        new("graph", "Finite Automata", "Trace strings through DFAs and NFAs drawn as state diagrams or transition tables, with instant visual feedback.", "sandbox?kind=dfa"),
        new("grammar", "Context-Free Grammar", "Understand the production rules that generate a language, with leftmost derivations and parse trees.", "sandbox?kind=cfg"),
        new("stack", "Pushdown Automaton", "Monitor stack memory visually as you step through non-regular languages.", "sandbox?kind=pda"),
        new("tape", "Turing Machine", "Watch the read/write head move across the tape, one configuration at a time.", "sandbox?kind=tm"),
        new("checks", "Quiz Arena", "Solve problems against visible and hidden test cases and get graded automatically.", "quizzes"),
        new("book", "Study Area", "Read notes aligned with the textbook and generate practice problems with AI.", "study")
    ];
}
