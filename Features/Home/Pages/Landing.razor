@page "/"
@layout BareLayout
@using ProfAlan.Features.Home.Components

<PageTitle>ProfAlan · Automata theory studio</PageTitle>

<div class="grid-paper-soft relative flex min-h-screen flex-col overflow-hidden">
    <PublicHeader />

    <main class="relative flex-1">
        <section class="relative mx-auto max-w-7xl px-4 pb-24 pt-16 text-center sm:px-8 sm:pt-24">
            @foreach (var tile in Tiles)
            {
                <span class="@($"float-tile absolute hidden place-items-center rounded-2xl bg-card font-mono font-semibold shadow-lg lg:grid {tile.Position}")"
                      style="@($"--tilt:{tile.Tilt}deg; animation-delay:{tile.Delay}s")" aria-hidden="true">@tile.Text</span>
            }
            @foreach (var spark in Sparkles)
            {
                <svg viewBox="0 0 24 24" class="@($"sparkle absolute hidden text-highlight lg:block {spark}")" aria-hidden="true">
                    <path d="M12 0c.8 6.6 5.4 11.2 12 12-6.6.8-11.2 5.4-12 12-.8-6.6-5.4-11.2-12-12C6.6 11.2 11.2 6.6 12 0Z" fill="currentColor" />
                </svg>
            }

            <h1 class="fade-up relative mx-auto max-w-5xl font-display text-5xl leading-[1.15] sm:text-7xl">
                <span class="relative inline-block">
                    <svg viewBox="0 0 40 40" class="absolute -left-10 -top-9 size-12 text-highlight sm:-left-12 sm:-top-11 sm:size-14" aria-hidden="true">
                        <path d="M6 30 16 24M10 14l12 8M22 4l6 14" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" />
                    </svg>
                    <span class="marker">Interactive</span>
                </span>
                Studio<br class="hidden sm:block" /> for Automata Theory<br class="hidden sm:block" /> and Formal Languages
            </h1>

            <p class="fade-up mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-muted" style="animation-delay:.1s">
                Build DFAs, PDAs and Turing machines, trace every configuration step by step,
                and get graded on hidden test cases, all faithful to Lewis &amp; Papadimitriou.
            </p>

            <AuthorizeView>
                <Authorized>
                    <a href="dashboard" class="raised-button fade-up mt-12" style="animation-delay:.2s">Go to dashboard</a>
                </Authorized>
                <NotAuthorized>
                    <a href="login" class="raised-button fade-up mt-12" style="animation-delay:.2s">Sign in</a>
                    <p class="fade-up mt-6 text-sm text-muted" style="animation-delay:.25s">
                        New here? <a href="register" class="font-semibold text-ink underline underline-offset-4">Create a free account</a>
                    </p>
                </NotAuthorized>
            </AuthorizeView>
        </section>

        <div class="mx-auto flex max-w-6xl items-center gap-6 px-4 sm:px-8" aria-hidden="true">
            <span class="h-px flex-1 border-t-4 border-dotted border-line"></span>
            <span class="font-display text-2xl text-muted sm:text-3xl">Grounded in the textbook</span>
            <span class="h-px flex-1 border-t-4 border-dotted border-line"></span>
        </div>
        <p class="mt-4 text-center font-mono text-sm text-muted">Lewis &amp; Papadimitriou, <em>Elements of the Theory of Computation</em>, 2nd edition</p>

        <section id="features" class="mx-auto mt-20 grid max-w-6xl scroll-mt-8 gap-6 px-4 sm:px-8 md:grid-cols-2 lg:grid-cols-3" aria-label="Features">
            @foreach (var card in Cards)
            {
                <article class="rounded-3xl border border-line bg-card p-8 shadow-sm">
                    <span class="grid size-12 place-items-center rounded-xl border border-line bg-surface/60">
                        <Icon Name="@card.Icon" Class="size-5" />
                    </span>
                    <h2 class="mt-8 text-xl font-semibold leading-snug">@card.Title</h2>
                    <p class="mt-3 leading-relaxed text-muted">@card.Text</p>
                </article>
            }
        </section>

        <div class="mt-10 text-center">
            <a href="features" class="btn-pill bg-card">See every feature in detail <Icon Name="arrow-right" /></a>
        </div>

        <section id="about" class="mx-auto mt-24 max-w-3xl scroll-mt-8 px-4 text-center sm:px-8">
            <p class="eyebrow">About us</p>
            <h2 class="mt-3 font-display text-3xl sm:text-4xl">Built for the automata theory classroom</h2>
            <p class="mt-5 leading-relaxed text-muted">
                ProfAlan is a final project for CSIT321, Applications Development and Emerging Technologies.
                It gives students one place to learn, simulate and be assessed on formal languages, and gives
                instructors CodeChum-style problems with hidden test cases.
            </p>
            <a href="about" class="btn-pill mt-8 bg-card">More about ProfAlan <Icon Name="arrow-right" /></a>
        </section>
    </main>

    <PublicFooter />
</div>

@code {
    private sealed record Tile(string Text, string Position, int Tilt, double Delay);
    private sealed record Card(string Icon, string Title, string Text);

    private static readonly Tile[] Tiles =
    [
        new("δ", "left-[6%] top-[4%] size-20 text-3xl", -8, 0),
        new("Σ*", "left-[1%] top-[38%] size-20 text-2xl", 6, 0.6),
        new("⊢*", "left-[8%] top-[72%] size-24 text-3xl", -5, 1.2),
        new("Γ", "right-[7%] top-[2%] size-16 text-2xl", 7, 0.3),
        new("▷⊔", "right-[2%] top-[42%] size-20 text-2xl", -6, 0.9),
        new("q₀", "right-[9%] top-[74%] size-20 text-2xl", 8, 1.5)
    ];

    private static readonly string[] Sparkles =
    [
        "left-[12%] top-[56%] size-7",
        "left-[24%] top-[92%] size-5",
        "right-[16%] top-[26%] size-6",
        "right-[22%] top-[66%] size-6"
    ];

    private static readonly Card[] Cards =
    [
        new("graph", "Finite Automata", "Trace strings through DFAs and NFAs drawn as state diagrams or transition tables, with instant visual feedback."),
        new("grammar", "Context-Free Grammar", "Understand the production rules that generate a language, with leftmost derivations and parse trees."),
        new("stack", "Pushdown Automaton", "Monitor stack memory visually as you step through non-regular languages."),
        new("tape", "Turing Machine", "Watch the read/write head move across the tape, one configuration at a time."),
        new("checks", "Quiz Arena", "Solve problems against visible and hidden test cases and get graded automatically."),
        new("wand", "AI Study Area", "Read notes aligned with the textbook and practice with problems generated by Google Gemini.")
    ];
}
