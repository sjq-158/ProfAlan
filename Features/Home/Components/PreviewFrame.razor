@* A static, non-interactive snapshot of part of the app. *@
<figure class="overflow-hidden rounded-2xl border border-line bg-card shadow-sm">
    <div class="flex items-center gap-3 border-b border-line px-6 py-4">
        <span class="truncate text-sm font-semibold">@Title</span>
        <span class="badge-muted ml-auto shrink-0">Preview</span>
    </div>
    <div class="pointer-events-none select-none" aria-hidden="true">
        @ChildContent
    </div>
    @if (Caption is not null)
    {
        <figcaption class="border-t border-line px-6 py-4 text-sm text-muted">@Caption</figcaption>
    }
</figure>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Caption { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
