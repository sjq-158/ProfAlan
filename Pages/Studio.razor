@page "/studio"
@using System.Globalization

<PageTitle>ProfAlan · Studio</PageTitle>

<div class="flex h-screen flex-col">

    <header class="flex h-16 shrink-0 items-center justify-between border-b border-neutral-200 px-6 dark:border-neutral-800">
        <a href="" class="flex items-center gap-3">
            <span class="grid size-9 place-items-center rounded-lg bg-ink font-mono text-sm font-semibold text-white dark:bg-white dark:text-ink">P</span>
            <span class="text-lg font-semibold tracking-tight">ProfAlan</span>
        </a>
        <ThemeToggle />
    </header>

    <div class="flex min-h-0 flex-1">

        @* Left: machine model *@
        <aside class="w-72 shrink-0 overflow-y-auto border-r border-neutral-200 p-6 dark:border-neutral-800">
            <p class="section-label mb-3">Machine model</p>
            <nav class="flex flex-col gap-1">
                @foreach (var kind in Kinds)
                {
                    <button type="button"
                            @onclick="() => selected = kind"
                            class="@NavClass(kind)">
                        @kind.DisplayName()
                    </button>
                }
            </nav>
        </aside>

        @* Center: definition + canvas *@
        <main class="flex min-w-0 flex-1 flex-col">
            <section class="border-b border-neutral-200 p-6 dark:border-neutral-800">
                <p class="section-label mb-3">Definition</p>
                <div class="rounded-xl border border-neutral-200 bg-white p-5 font-mono text-sm shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
                    L = { w ∈ {a,b}* | w has an even number of a's }
                </div>
            </section>

            <section class="dot-grid min-h-0 flex-1 p-6">
                <div class="h-full rounded-2xl border border-neutral-200 bg-white p-2 shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
                    @if (selected == MachineKind.Dfa)
                    {
                        <svg viewBox="0 0 600 400" class="h-full w-full text-neutral-500">
                            <defs>
                                <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                                    <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
                                </marker>
                            </defs>

                            @foreach (var edge in Edges())
                            {
                                var g = Geometry(edge);
                                <path d="@g.Path" fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#arrow)" />
                                <SvgText X="g.Lx" Y="g.Ly" Class="fill-current font-mono text-[13px]">@edge.Label</SvgText>
                            }

                            @foreach (var s in dfa.States)
                            {
                                if (s.IsStart)
                                {
                                    <line x1="@F(s.X - 70)" y1="@F(s.Y)" x2="@F(s.X - R - 2)" y2="@F(s.Y)"
                                          stroke="currentColor" stroke-width="1.5" marker-end="url(#arrow)" />
                                }
                                <circle cx="@F(s.X)" cy="@F(s.Y)" r="@F(R)" stroke-width="2"
                                        class="fill-white stroke-ink dark:fill-neutral-900 dark:stroke-white" />
                                if (s.IsAccepting)
                                {
                                    <circle cx="@F(s.X)" cy="@F(s.Y)" r="@F(R - 5)" stroke-width="1.5" fill="none"
                                            class="stroke-ink dark:stroke-white" />
                                }
                                <SvgText X="s.X" Y="s.Y" Class="fill-ink font-mono text-sm font-medium dark:fill-white">@s.Id</SvgText>
                            }
                        </svg>
                    }
                    else
                    {
                        <div class="grid h-full place-items-center font-mono text-sm uppercase tracking-widest text-neutral-400">
                            @selected.DisplayName() · coming soon
                        </div>
                    }
                </div>
            </section>
        </main>

        @* Right: runtime tests *@
        <aside class="flex w-80 shrink-0 flex-col border-l border-neutral-200 dark:border-neutral-800">
            <div class="border-b border-neutral-200 p-6 dark:border-neutral-800">
                <div class="mb-4 flex items-center justify-between">
                    <p class="section-label">Runtime tests</p>
                    <span class="rounded-full bg-neutral-100 px-2.5 py-0.5 font-mono text-xs dark:bg-neutral-800">@tests.Count</span>
                </div>

                <div class="flex gap-2">
                    <input @bind="newTest" @bind:event="oninput" @onkeydown="OnKeyDown"
                           placeholder="String (blank=ε)"
                           class="min-w-0 flex-1 rounded-lg border border-neutral-300 bg-transparent px-3 py-2 font-mono text-sm outline-none focus:border-ink dark:border-neutral-700 dark:focus:border-white" />
                    <button type="button" @onclick="AddTest" aria-label="Add test"
                            class="grid size-10 place-items-center rounded-lg bg-ink text-xl text-white dark:bg-white dark:text-ink">+</button>
                </div>

                <button type="button" @onclick="RunAll"
                        class="mt-3 w-full rounded-lg bg-ink py-2.5 text-sm font-semibold text-white dark:bg-white dark:text-ink">
                    Run All
                </button>
            </div>

            <div class="flex-1 overflow-y-auto p-6">
                @if (tests.Count == 0)
                {
                    <p class="mt-10 text-center font-mono text-xs uppercase tracking-widest text-neutral-400">No test tasks.</p>
                }
                else
                {
                    <ul class="flex flex-col gap-2">
                        @foreach (var t in tests)
                        {
                            <li class="flex items-center justify-between rounded-lg border border-neutral-200 px-3 py-2 font-mono text-sm dark:border-neutral-800">
                                <span>@(t.Input.Length == 0 ? "ε" : t.Input)</span>
                                @if (t.Accepted is bool ok)
                                {
                                    <span class="@(ok ? "font-semibold" : "text-neutral-400 line-through")">@(ok ? "ACCEPT" : "REJECT")</span>
                                }
                                else
                                {
                                    <span class="text-neutral-400">…</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </aside>
    </div>
</div>

@code {
    private const double R = 24;

    private static readonly MachineKind[] Kinds = Enum.GetValues<MachineKind>();

    private sealed record TestCase(string Input, bool? Accepted = null);
    private sealed record Edge(State From, State To, string Label, bool Curved);

    private readonly Dfa dfa = SampleMachines.EvenAs();
    private MachineKind selected = MachineKind.Dfa;
    private List<TestCase> tests = [];
    private string newTest = "";

    private string NavClass(MachineKind kind) =>
        "rounded-lg px-4 py-3 text-left text-sm font-medium transition " +
        (kind == selected
            ? "bg-neutral-100 dark:bg-neutral-800"
            : "text-neutral-500 hover:bg-neutral-50 dark:hover:bg-neutral-900");

    private void AddTest()
    {
        tests.Add(new TestCase(newTest.Trim()));
        newTest = "";
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTest();
    }

    private void RunAll() =>
        tests = tests.Select(t => t with { Accepted = dfa.Run(t.Input).Accepted }).ToList();

    private IEnumerable<Edge> Edges()
    {
        foreach (var g in dfa.Transitions.GroupBy(t => (t.From, t.To)))
        {
            var a = dfa.States.First(s => s.Id == g.Key.From);
            var b = dfa.States.First(s => s.Id == g.Key.To);
            var label = string.Join(", ", g.Select(t => t.Label));
            var curved = a.Id != b.Id && dfa.Transitions.Any(t => t.From == b.Id && t.To == a.Id);
            yield return new Edge(a, b, label, curved);
        }
    }

    private static (string Path, double Lx, double Ly) Geometry(Edge e)
    {
        var (a, b) = (e.From, e.To);

        if (a.Id == b.Id)
        {
            var loop = $"M {F(a.X - 14)} {F(a.Y - R + 3)} C {F(a.X - 34)} {F(a.Y - R - 44)}, {F(a.X + 34)} {F(a.Y - R - 44)}, {F(a.X + 14)} {F(a.Y - R + 3)}";
            return (loop, a.X, a.Y - R - 38);
        }

        var dx = b.X - a.X;
        var dy = b.Y - a.Y;
        var len = Math.Sqrt(dx * dx + dy * dy);
        var nx = -dy / len;
        var ny = dx / len;

        var off = e.Curved ? 38 : 0;
        var cx = (a.X + b.X) / 2 + nx * off;
        var cy = (a.Y + b.Y) / 2 + ny * off;

        var (sx, sy) = Trim(a.X, a.Y, cx, cy);
        var (ex, ey) = Trim(b.X, b.Y, cx, cy);

        var lx = 0.25 * sx + 0.5 * cx + 0.25 * ex + nx * 14;
        var ly = 0.25 * sy + 0.5 * cy + 0.25 * ey + ny * 14;

        return ($"M {F(sx)} {F(sy)} Q {F(cx)} {F(cy)} {F(ex)} {F(ey)}", lx, ly);
    }

    private static (double X, double Y) Trim(double x, double y, double tx, double ty)
    {
        var dx = tx - x;
        var dy = ty - y;
        var len = Math.Sqrt(dx * dx + dy * dy);
        return (x + dx / len * R, y + dy / len * R);
    }

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}