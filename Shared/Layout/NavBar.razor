@inject AuthSession Auth
@inject NavigationManager Navigation

<header class="sticky top-0 z-30 border-b border-line bg-surface/90 backdrop-blur">
    <div class="mx-auto flex h-16 max-w-7xl items-center gap-6 px-4 sm:px-6">
        <a href="" class="flex items-center gap-2.5">
            <BrandMark Class="size-8 text-ink" />
            <span class="font-display text-xl">ProfAlan</span>
        </a>

        <nav class="hidden items-center gap-1 md:flex">
            <AuthorizeView>
                <Authorized>
                    <NavLink class="tab" ActiveClass="tab-active" href="dashboard">Dashboard</NavLink>
                </Authorized>
            </AuthorizeView>
            <NavLink class="tab" ActiveClass="tab-active" href="sandbox">Sandbox</NavLink>
            <NavLink class="tab" ActiveClass="tab-active" href="quizzes">Quizzes</NavLink>
            <NavLink class="tab" ActiveClass="tab-active" href="study">Study Area</NavLink>
        </nav>

        <div class="ml-auto flex items-center gap-2">
            @if (Auth.IsDemo)
            {
                <span class="badge-muted hidden lg:inline-flex" title="No Supabase project is configured. Accounts and data are stored in this browser.">Demo mode</span>
            }
            <ThemePicker />
            <AuthorizeView>
                <Authorized>
                    <div class="relative">
                        <button type="button" class="flex items-center gap-2 rounded-lg border border-line py-1 pl-1 pr-2.5 transition hover:bg-soft" @onclick="() => menuOpen = !menuOpen">
                            <span class="grid size-7 place-items-center rounded-md bg-ink font-mono text-xs font-semibold text-surface">@Auth.Current?.Initials</span>
                            <span class="hidden text-sm font-medium sm:inline">@Auth.Current?.DisplayName</span>
                            <Icon Name="chevron-down" Class="size-3.5 text-muted" />
                        </button>
                        @if (menuOpen)
                        {
                            <div class="fixed inset-0 z-40" @onclick="() => menuOpen = false"></div>
                            <div class="card absolute right-0 z-50 mt-2 w-60 p-1.5 shadow-lg">
                                <div class="px-2.5 py-2">
                                    <p class="text-sm font-medium">@Auth.Current?.DisplayName</p>
                                    <p class="truncate text-xs text-muted">@Auth.Current?.Email</p>
                                    <span class="badge-muted mt-2">@Auth.Current?.Role</span>
                                </div>
                                <div class="my-1 border-t border-line"></div>
                                <a href="dashboard" class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm hover:bg-soft" @onclick="() => menuOpen = false">
                                    <Icon Name="dashboard" /> Dashboard
                                </a>
                                <button type="button" class="flex w-full items-center gap-2 rounded-md px-2.5 py-2 text-left text-sm hover:bg-soft" @onclick="SignOutAsync">
                                    <Icon Name="logout" /> Sign out
                                </button>
                            </div>
                        }
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a href="login" class="btn btn-ghost hidden sm:inline-flex">Sign in</a>
                    <a href="register" class="btn btn-primary">Get started</a>
                </NotAuthorized>
            </AuthorizeView>
            <button type="button" class="btn-icon md:hidden" aria-label="Open menu" @onclick="() => mobileOpen = !mobileOpen">
                <Icon Name="@(mobileOpen ? "x" : "menu")" />
            </button>
        </div>
    </div>

    @if (mobileOpen)
    {
        <nav class="flex flex-col gap-1 border-t border-line px-4 py-3 md:hidden" @onclick="() => mobileOpen = false">
            <AuthorizeView>
                <Authorized>
                    <NavLink class="tab" ActiveClass="tab-active" href="dashboard">Dashboard</NavLink>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="tab" ActiveClass="tab-active" href="login">Sign in</NavLink>
                </NotAuthorized>
            </AuthorizeView>
            <NavLink class="tab" ActiveClass="tab-active" href="sandbox">Sandbox</NavLink>
            <NavLink class="tab" ActiveClass="tab-active" href="quizzes">Quizzes</NavLink>
            <NavLink class="tab" ActiveClass="tab-active" href="study">Study Area</NavLink>
        </nav>
    }
</header>

@code {
    private bool menuOpen;
    private bool mobileOpen;

    private async Task SignOutAsync()
    {
        menuOpen = false;
        await Auth.SignOutAsync();
        Navigation.NavigateTo("");
    }
}
