<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <div class="grid min-h-[60vh] place-items-center text-muted"><Spinner Class="size-6" /></div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Page not found · ProfAlan</PageTitle>
            <LayoutView Layout="typeof(MainLayout)">
                <div class="mx-auto flex min-h-[60vh] max-w-md flex-col items-center justify-center gap-4 px-6 text-center">
                    <p class="font-mono text-sm text-muted">δ(q, w) is undefined</p>
                    <h1 class="font-display text-5xl">404</h1>
                    <p class="text-muted">This page is not in the language of ProfAlan.</p>
                    <div class="flex gap-2">
                        <a href="" class="btn"><Icon Name="home" /> Home</a>
                        <a href="sandbox" class="btn btn-primary">Open sandbox</a>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
