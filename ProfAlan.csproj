<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProfAlan</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;node_modules/**;supabase/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.*" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="TailwindInstall" BeforeTargets="BeforeBuild" Condition="!Exists('node_modules')">
    <Exec Command="npm install" />
  </Target>
  <Target Name="TailwindBuild" BeforeTargets="BeforeBuild" DependsOnTargets="TailwindInstall">
    <Exec Command="npm run css:build" />
  </Target>

</Project>