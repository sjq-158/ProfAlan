# Copy to .env and fill in. .env is git-ignored; wwwroot/appsettings.json is generated from it on build.
# Supabase dashboard > Project Settings > API Keys. Either the legacy anon key or the publishable key works.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=

# Free-tier key from Google AI Studio. Used only by `npm run ai:deploy`, which stores it as a
# Supabase secret for the gemini Edge Function. It is never written to appsettings.json.
GEMINI_API_KEY=
